<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.codybot.app">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="CodyBot 3.8"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity android:name="com.codybot.prototype.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.codybot.prototype.MediaProjectionActivity"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:excludeFromRecents="true" android:exported="false" />
        <service android:name="com.codybot.app.CodyAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service_config" />
        </service>
        <service android:name="com.codybot.prototype.ScreenCaptureService"
            android:exported="false" android:foregroundServiceType="mediaProjection" />
        <service android:name="com.codybot.prototype.SchemaCalibrationService"
            android:exported="false" />
    </application>
</manifest>
